<Project>
  <PropertyGroup>
    <!-- Avalonia 0.10's Windows renderer (av_libglesv2.dll from Avalonia.Angle.Windows.Natives)
         only ships for the win7-x64/win7-x86 runtime identifiers. .NET 8+ only knows those
         RIDs with the legacy RID graph, so the Windows package is published for win7-* with
         this on. Set for every project because `dotnet publish -r` passes the RID to the
         referenced projects too. Remove once Avalonia is upgraded. -->
    <UseRidGraph>true</UseRidGraph>
  </PropertyGroup>
</Project>
