<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
	<Version>0.0.63.90</Version>
    <OutputType>WinExe</OutputType>
	<Title>PTZ Joystick Control</Title>
	<AssemblyTitle>PTZ Joystick Control</AssemblyTitle>
	<AssemblyName>Gui</AssemblyName>
	<ApplicationIcon>./Assets/icon.ico</ApplicationIcon>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <!-- Bindings in XAML stay reflection bindings, as before Avalonia 12 (which compiles them by
         default and would need x:DataType on every view). -->
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <RootNamespace>PtzJoystickControl.Gui</RootNamespace>
    <Platforms>AnyCPU;x64</Platforms>
  </PropertyGroup>
  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
    <None Remove=".gitignore" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.4" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.4" />
    <!-- Service locator (Locator.Current); came with Avalonia.ReactiveUI before Avalonia 12. -->
    <PackageReference Include="Splat" Version="21.0.0" />
  </ItemGroup>
  <!-- SkiaSharp 3 and HarfBuzzSharp 8 ship the native libraries' pdbs (about 105 MB). They are
       not needed for the logged managed stack traces, so they stay out of the published folder. -->
  <Target Name="ExcludeNativePdbsFromPublish" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(Filename)%(Extension)' == 'libSkiaSharp.pdb' Or '%(Filename)%(Extension)' == 'libHarfBuzzSharp.pdb'" />
    </ItemGroup>
  </Target>
  <ItemGroup>
    <ProjectReference Include="..\Application\Application.csproj" />
    <ProjectReference Include="..\Core\Core.csproj" />
    <ProjectReference Include="..\SdlGamepads\SdlGamepads.csproj" />
    <ProjectReference Include="..\SkaarhojPanel\SkaarhojPanel.csproj" />
  </ItemGroup>
</Project>