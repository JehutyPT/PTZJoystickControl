<Project>
  <Import Project="Sdk.props" Sdk="WixToolset.Sdk" Version="5.0.2" />
  <Import Project="Sdk.targets" Sdk="WixToolset.Sdk" Version="5.0.2" />

  <!-- WiX only builds MSIs on Windows (elsewhere it fails with WIX0389). Off Windows,
       Build only prints a message, so PTZJoystickControl.sln builds and tests on
       macOS and Linux. Set after Sdk.targets so it replaces the WiX build steps. -->
  <PropertyGroup Condition="!$([MSBuild]::IsOSPlatform('Windows'))">
    <BuildDependsOn>SkipMsiOffWindows</BuildDependsOn>
  </PropertyGroup>

  <Target Name="SkipMsiOffWindows">
    <Message Importance="high" Text="Skipping $(MSBuildProjectName): the MSI is built on Windows only." />
  </Target>
</Project>
